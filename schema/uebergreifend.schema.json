{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lernwerk/uebergreifend.schema.json",
  "title": "LERNWERK übergreifende Klassenarbeitsaufgaben (_uebergreifend.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["fach", "klasse", "titel", "verifiziert", "aufgaben"],
  "properties": {
    "fach": { "enum": ["mathematik", "latein", "geschichte", "deutsch", "biologie", "englisch"] },
    "klasse": { "type": "integer", "minimum": 5, "maximum": 12 },
    "titel": { "type": "string", "minLength": 3 },
    "lehrplanbezug": { "type": "array", "items": { "type": "string" } },
    "verifiziert": { "type": "boolean" },
    "quelle": { "type": "string" },
    "aufgaben": {
      "type": "array",
      "minItems": 1,
      "items": { "allOf": [{ "$ref": "content.schema.json#/definitions/aufgabe" }, { "type": "object", "required": ["afb", "themen"] }] }
    }
  }
}
